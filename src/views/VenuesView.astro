---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHero from '@components/sections/landing/PageHero.astro';
import heroImage from '@images/heroes/venues.jpg';
import Section from '@components/ui/blocks/Section.astro';
import SectionHeader from '@components/ui/blocks/SectionHeader.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { venues, VENUE_FORM_URL } from '@data/venues';
import { BOOKING_DAYS_AHEAD } from '@data/firebase';
import { socialLinks } from '@data/navigation';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * 場地借用：借用狀況（一週行事曆）→ 場地介紹（含進入方式）→ 借用辦法 → 使用規範。
 * 場地在 `src/data_files/venues.ts`；借用紀錄存在 Firestore，由瀏覽器即時讀取，
 * 系上同學登入後可以直接在借用狀況表上預約（畫面邏輯在 `@scripts/venueSchedule`）。
 * 借用辦法與使用規範的文字在 `copy.venues.howTo` 與 `copy.venues.rules`
 * （內容依「工管系空間使用規章」）。
 *
 * 網站是事先產生好的，所以「本週」是在瀏覽器裡依照當天日期算出來的，
 * 不需要每週重新部署，新增預約也不需要。
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).venues;

// 交給瀏覽器端的資料（行事曆在瀏覽器裡畫出來）
const scheduleData = {
  venues: venues.map(({ id, name, tables, tableMaxHours }) => ({
    id,
    name,
    tables,
    tableMaxHours,
  })),
  daysAhead: BOOKING_DAYS_AHEAD,
  labels: copy.schedule,
  booking: copy.booking,
};
const daysAheadText = copy.booking.daysAhead.replace(
  '{n}',
  String(BOOKING_DAYS_AHEAD)
);
---

<MainLayout title={copy.title} description={copy.metaDescription}>
  <PageHero
    title={copy.title}
    subTitle={copy.hero.subTitle}
    image={heroImage}
  />

  {/* 借用狀況 */}
  <Section id="schedule" tone="muted">
    <SectionHeader
      title={copy.schedule.title}
      subTitle={copy.schedule.subTitle}
    />

    <div data-venue-schedule>
      {/* 線上預約提示列：依登入狀態與角色顯示不同的提示（Firebase 沒設定時不顯示） */}
      <div
        class="mb-6 hidden flex-col gap-3 rounded-2xl border border-yellow-400/60 bg-yellow-400/10 p-4 sm:flex-row sm:items-center sm:justify-between"
        data-booking-bar
      >
        <p class="text-sm text-neutral-700 dark:text-neutral-300">
          <span data-booking-hint></span>
          <span class="hidden" data-booking-days>{daysAheadText}</span>
        </p>
        <button
          type="button"
          class="hidden shrink-0 items-center gap-x-2 self-start rounded-xl bg-neutral-800 px-4 py-2.5 text-sm font-bold text-neutral-50 transition hover:bg-neutral-700 sm:self-center"
          data-booking-signin
        >
          <Icon name="google" class="h-4 w-4" />
          {copy.booking.signInBtn}
        </button>
        <a
          href={localePath(locale, '/profile')}
          class="hidden shrink-0 items-center self-start rounded-xl bg-neutral-800 px-4 py-2.5 text-sm font-bold text-neutral-50 transition hover:bg-neutral-700 sm:self-center"
          data-booking-profile
        >
          {copy.booking.profileBtn}
        </a>
        <button
          type="button"
          class="hidden shrink-0 items-center gap-x-2 self-start rounded-xl bg-yellow-400 px-4 py-2.5 text-sm font-bold text-neutral-800 transition hover:bg-yellow-500 sm:self-center"
          data-booking-open
        >
          {copy.booking.bookBtn}
        </button>
      </div>

      <p
        class="mb-4 hidden text-sm text-neutral-500 dark:text-neutral-400"
        data-schedule-status
      >
      </p>

      {/* 週切換 */}
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <p
          class="text-lg font-bold text-neutral-800 dark:text-neutral-200"
          data-week-label
        ></p>
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="week-btn"
            data-week-prev
            aria-label={copy.schedule.prevWeek}
          >
            <Icon name="arrowRight" class="h-4 w-4 rotate-180" />
            <span class="hidden sm:inline">{copy.schedule.prevWeek}</span>
          </button>
          <button type="button" class="week-btn" data-week-today>
            {copy.schedule.thisWeek}
          </button>
          <button
            type="button"
            class="week-btn"
            data-week-next
            aria-label={copy.schedule.nextWeek}
          >
            <span class="hidden sm:inline">{copy.schedule.nextWeek}</span>
            <Icon name="arrowRight" class="h-4 w-4" />
          </button>
        </div>
      </div>

      {/* 電腦版：場地 × 星期 的表格 */}
      <div class="hidden overflow-hidden rounded-2xl border border-neutral-300/60 bg-neutral-50 md:block dark:border-neutral-700 dark:bg-neutral-900/60">
        <table class="w-full table-fixed border-collapse text-sm">
          <thead data-week-head></thead>
          <tbody data-week-body></tbody>
        </table>
      </div>

      {/* 手機版：一天一張卡片 */}
      <div class="space-y-3 md:hidden" data-week-days></div>

      <noscript>
        <p class="rounded-xl bg-neutral-50 p-4 text-neutral-600">
          {copy.schedule.noscript}
        </p>
      </noscript>
    </div>

    <script
      type="application/json"
      id="venue-schedule-data"
      set:html={JSON.stringify(scheduleData)}
    />

    {/* 預約視窗 */}
    <dialog
      class="booking-dialog m-auto w-[min(32rem,calc(100vw-2rem))] rounded-2xl bg-neutral-50 p-0 text-neutral-800 shadow-2xl dark:bg-neutral-900 dark:text-neutral-200"
      data-booking-dialog
    >
      <form class="space-y-4 p-6" data-booking-form>
        <h3 class="text-xl font-bold">{copy.booking.dialogTitle}</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="booking-field">
            <span>{copy.booking.venue}</span>
            <select name="venue">
              {venues.map(v => <option value={v.id}>{v.name}</option>)}
            </select>
          </label>
          <label class="booking-field" data-table-field>
            <span>{copy.booking.table}</span>
            <select name="table"></select>
          </label>
          <label class="booking-field sm:col-span-2">
            <span>{copy.booking.date}</span>
            <input type="date" name="date" required />
          </label>
          <label class="booking-field">
            <span>{copy.booking.start}</span>
            <input type="time" name="start" step="600" required />
          </label>
          <label class="booking-field">
            <span>{copy.booking.end}</span>
            <input type="time" name="end" step="600" required />
          </label>
          <label class="booking-field sm:col-span-2">
            <span>{copy.booking.by}</span>
            <input
              type="text"
              name="by"
              maxlength="30"
              required
              placeholder={copy.booking.byPlaceholder}
            />
          </label>
          <label class="booking-field sm:col-span-2">
            <span>{copy.booking.purpose}</span>
            <input
              type="text"
              name="purpose"
              maxlength="50"
              placeholder={copy.booking.purposePlaceholder}
            />
          </label>
        </div>
        <p
          class="hidden rounded-lg bg-red-500/10 px-3 py-2 text-sm text-red-600 dark:text-red-400"
          role="alert"
          data-booking-error
        >
        </p>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" class="week-btn" data-booking-cancel>
            {copy.booking.cancel}
          </button>
          <button
            type="submit"
            class="rounded-xl bg-yellow-400 px-5 py-2.5 text-sm font-bold text-neutral-800 transition hover:bg-yellow-500 disabled:opacity-60"
            data-booking-submit
          >
            {copy.booking.submit}
          </button>
        </div>
      </form>
    </dialog>

    {/* 操作結果的小提示 */}
    <div
      class="pointer-events-none fixed inset-x-0 bottom-6 z-100 flex justify-center px-4"
      aria-live="polite"
    >
      <p
        class="hidden rounded-full bg-neutral-800 px-5 py-2.5 text-sm font-semibold text-neutral-50 shadow-lg dark:bg-neutral-100 dark:text-neutral-800"
        data-booking-toast
      >
      </p>
    </div>
  </Section>

  {/* 場地介紹 */}
  <Section id="venues">
    <SectionHeader title={copy.list.title} subTitle={copy.list.subTitle} />

    {/* 進入方式 */}
    <div class="mb-8 flex flex-col gap-4 rounded-2xl border border-yellow-400/60 bg-yellow-400/10 p-5 sm:flex-row sm:items-center sm:justify-between md:p-6">
      <div class="flex gap-x-4">
        <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-yellow-400 text-neutral-800">
          <Icon name="user" class="h-6 w-6" />
        </span>
        <div>
          <p class="font-bold text-neutral-800 dark:text-neutral-200">
            {copy.access.title}：{copy.access.text}
          </p>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            {copy.access.help}
          </p>
        </div>
      </div>
      {socialLinks.instagram && (
        <a
          href={socialLinks.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex shrink-0 items-center gap-x-2 self-start rounded-xl bg-neutral-800 px-4 py-2.5 text-sm font-bold text-neutral-50 transition hover:bg-neutral-700 sm:self-center"
        >
          <Icon name="instagram" class="h-4 w-4" />
          {copy.access.helpBtn}
        </a>
      )}
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {venues.map(venue => (
        <article class="rounded-2xl border border-neutral-300/60 bg-neutral-50 p-6 dark:border-neutral-700 dark:bg-neutral-900/50">
          <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
            {venue.name}
          </h3>
          {(venue.location || venue.capacity) && (
            <dl class="mt-4 space-y-2 text-sm">
              {venue.location && (
                <div class="flex gap-x-2">
                  <dt class="flex shrink-0 items-center gap-x-1.5 font-semibold text-neutral-500 dark:text-neutral-400">
                    <Icon name="mapPin" class="h-4 w-4" />
                    {copy.list.location}
                  </dt>
                  <dd class="text-neutral-700 dark:text-neutral-300">
                    {venue.location}
                  </dd>
                </div>
              )}
              {venue.capacity && (
                <div class="flex gap-x-2">
                  <dt class="flex shrink-0 items-center gap-x-1.5 font-semibold text-neutral-500 dark:text-neutral-400">
                    <Icon name="user" class="h-4 w-4" />
                    {copy.list.capacity}
                  </dt>
                  <dd class="text-neutral-700 dark:text-neutral-300">
                    {venue.capacity}
                  </dd>
                </div>
              )}
            </dl>
          )}
          {venue.tables && (
            <>
              <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
                {copy.list.tablesNote}
              </p>
              <ul class="mt-2 flex flex-wrap gap-2">
                {venue.tables.map(table => (
                  <li class="rounded-full bg-orange-400/15 px-3 py-1 text-sm font-semibold text-orange-600 dark:text-orange-300">
                    {table}
                  </li>
                ))}
              </ul>
            </>
          )}
          {venue.notes && venue.notes.length > 0 && (
            <ul class="mt-4 space-y-1.5 text-sm text-neutral-700 dark:text-neutral-300">
              {venue.notes.map(note => (
                <li class="flex gap-x-2">
                  <Icon
                    name="alert"
                    class="mt-0.5 h-4 w-4 shrink-0 text-orange-500"
                  />
                  {note}
                </li>
              ))}
            </ul>
          )}
          {venue.equipment && venue.equipment.length > 0 && (
            <>
              <p class="mt-4 text-xs font-semibold text-neutral-500 dark:text-neutral-400">
                {copy.list.equipment}
              </p>
              <ul class="mt-2 flex flex-wrap gap-2">
                {venue.equipment.map(item => (
                  <li class="rounded-full bg-yellow-400/25 px-3 py-1 text-sm text-neutral-800 dark:text-neutral-200">
                    {item}
                  </li>
                ))}
              </ul>
            </>
          )}
        </article>
      ))}
    </div>
  </Section>

  {/* 借用辦法 */}
  <Section id="apply" tone="muted">
    <SectionHeader title={copy.howTo.title} subTitle={copy.howTo.subTitle} />
    <div class="grid gap-6 md:grid-cols-2">
      {[copy.howTo.single, copy.howTo.whole].map((option, i) => (
        <article class="flex flex-col rounded-2xl border border-neutral-300/60 bg-neutral-50 p-6 md:p-8 dark:border-neutral-700 dark:bg-neutral-900/60">
          <div class="flex items-center gap-x-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-yellow-400 font-bold text-neutral-800">
              {i + 1}
            </span>
            <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
              {option.title}
            </h3>
            <span class="rounded-full bg-orange-400/15 px-3 py-1 text-xs font-semibold text-orange-600 dark:text-orange-300">
              {option.tag}
            </span>
          </div>
          <ul class="mt-5 grow space-y-3">
            {option.items.map(item => (
              <li class="flex gap-x-2 text-neutral-700 dark:text-neutral-300">
                <Icon
                  name="checkCircle"
                  class="mt-0.5 h-5 w-5 shrink-0 text-yellow-500"
                />
                {item}
              </li>
            ))}
          </ul>
          {'btn' in option &&
            (VENUE_FORM_URL ? (
              <a
                href={VENUE_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center gap-x-2 self-start rounded-xl bg-yellow-400 px-5 py-3 font-bold text-neutral-800 transition hover:bg-yellow-500"
              >
                {option.btn}
                <Icon name="openInNew" class="h-4 w-4" />
              </a>
            ) : (
              <span class="mt-6 inline-flex cursor-not-allowed items-center self-start rounded-xl bg-neutral-200 px-5 py-3 font-bold text-neutral-400 dark:bg-neutral-800">
                {option.btn}
              </span>
            ))}
        </article>
      ))}
    </div>
  </Section>

  {/* 使用規範 */}
  <Section id="rules">
    <SectionHeader title={copy.rules.title} subTitle={copy.rules.subTitle} />
    <ol class="grid gap-3 md:grid-cols-2">
      {copy.rules.items.map((rule, i) => (
        <li class="flex gap-x-4 rounded-2xl border border-neutral-300/60 bg-neutral-50 p-4 dark:border-neutral-700 dark:bg-neutral-900/50">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-neutral-800 text-sm font-bold text-yellow-400 dark:bg-neutral-700">
            {i + 1}
          </span>
          <span class="pt-1 text-pretty text-neutral-700 dark:text-neutral-300">
            {rule}
          </span>
        </li>
      ))}
    </ol>
  </Section>
</MainLayout>

<style is:global>
  .week-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 9999px;
    border: 1px solid var(--color-neutral-300);
    background: var(--color-neutral-50);
    padding: 0.45rem 0.9rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-neutral-700);
    transition: background-color 0.2s;
  }
  .week-btn:hover {
    background: var(--color-yellow-100);
  }
  .dark .week-btn {
    border-color: var(--color-neutral-700);
    background: var(--color-neutral-800);
    color: var(--color-neutral-300);
  }
  .dark .week-btn:hover {
    background: var(--color-neutral-700);
  }
  .booking-chip {
    display: block;
    border-radius: 0.6rem;
    background: color-mix(in oklab, var(--color-yellow-400) 35%, transparent);
    border-left: 3px solid var(--color-yellow-500);
    padding: 0.35rem 0.5rem;
    line-height: 1.3;
    color: var(--color-neutral-800);
  }
  .dark .booking-chip {
    color: var(--color-neutral-100);
  }
  .booking-chip.is-mine {
    border-left-color: var(--color-orange-500);
  }
  .booking-remove {
    margin-top: 0.25rem;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-red-600);
  }
  .booking-remove:hover {
    text-decoration: underline;
  }
  .dark .booking-remove {
    color: var(--color-red-400);
  }
  .slot-free {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0.6rem;
    padding: 0.25rem;
    text-align: left;
    font-size: 0.75rem;
    color: var(--color-neutral-400);
  }
  button.slot-free {
    border: 1px dashed transparent;
    cursor: pointer;
  }
  button.slot-free:hover {
    border-color: var(--color-yellow-500);
    background: color-mix(in oklab, var(--color-yellow-400) 15%, transparent);
    color: var(--color-neutral-700);
  }
  .dark button.slot-free:hover {
    color: var(--color-neutral-200);
  }
  .booking-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .booking-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .booking-field input,
  .booking-field select {
    border-radius: 0.75rem;
    border: 1px solid var(--color-neutral-300);
    background: white;
    padding: 0.55rem 0.75rem;
    font-weight: 400;
  }
  .dark .booking-field input,
  .dark .booking-field select {
    border-color: var(--color-neutral-700);
    background: var(--color-neutral-800);
    color: var(--color-neutral-100);
  }
</style>

<script>
  import '@scripts/venueSchedule';
</script>
