---
import type { ImageMetadata } from 'astro';
import MainLayout from '@/layouts/MainLayout.astro';
import PageHero from '@components/sections/landing/PageHero.astro';
import heroImage from '@images/heroes/activities.jpg';
import Section from '@components/ui/blocks/Section.astro';
import PhotoCarousel from '@components/ui/blocks/PhotoCarousel.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { activities } from '@data/activities';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/**
 * 活動成果：一個活動一行，依時間由上到下排列，活動之間用細線隔開。
 * 每一行一邊是可以左右滑動的活動照片，另一邊直接顯示時間、名稱、簡介，
 * 以及「活動網站」與「活動相簿」按鈕；照片左右交替擺放。手機版照片在上、文字在下。
 * 活動清單在 `src/data_files/activities.ts`，照片放在 `src/images/activities/`；
 * 照片還沒放的會顯示暖色的預留位置，連結還沒填的按鈕會顯示成虛線、不能點。
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).activities;

// 讀進 src/images/activities/ 裡所有照片，讓 activities.ts 只要寫檔名就好
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/activities/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
function photoOf(filename: string): ImageMetadata {
  const photo = photoFiles[`/src/images/activities/${filename}`];
  if (!photo) {
    throw new Error(
      `找不到活動照片 src/images/activities/${filename}，請確認檔名（含副檔名、大小寫）是否正確。`
    );
  }
  return photo.default;
}

// 還沒放照片時的預留位置：每個活動三張暖色漸層，依順序錯開顏色
const gradients = [
  'from-yellow-300 to-orange-400',
  'from-orange-300 to-red-400',
  'from-yellow-200 to-orange-300',
  'from-orange-400 to-red-500',
  'from-yellow-300 to-yellow-500',
  'from-red-300 to-orange-400',
  'from-orange-200 to-yellow-400',
];
const placeholdersFor = (i: number) =>
  [0, 1, 2].map(k => gradients[(i + k * 3) % gradients.length]);

const buttonBase =
  'inline-flex items-center gap-x-1.5 rounded-lg px-4 py-2 text-sm font-bold transition';
const disabledButton =
  'cursor-not-allowed border border-dashed border-neutral-300 text-neutral-400 dark:border-neutral-700 dark:text-neutral-500';
---

<MainLayout title={copy.title} description={copy.metaDescription}>
  <PageHero
    title={copy.title}
    subTitle={copy.hero.subTitle}
    image={heroImage}
  />

  <Section>
    <ol class="divide-y divide-neutral-300/70 dark:divide-neutral-700">
      {activities.map((activity, i) => {
        // 照片左右交替：單數在左、雙數在右
        const photoRight = i % 2 === 1;
        const buttons = [
          {
            label: copy.websiteBtn,
            url: activity.website,
            style: 'bg-yellow-400 text-neutral-800 hover:bg-yellow-500',
          },
          {
            label: copy.photosBtn,
            url: activity.photos,
            style:
              'border border-neutral-300 bg-neutral-50 text-neutral-700 hover:bg-neutral-200 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700',
          },
        ];
        return (
          <li
            id={activity.id}
            class="scroll-mt-8 py-10 first:pt-0 last:pb-0 md:py-14"
          >
            <article
              class:list={[
                'flex flex-col gap-6 md:items-center md:gap-12 lg:gap-16',
                photoRight ? 'md:flex-row-reverse' : 'md:flex-row',
              ]}
            >
              {/* 活動照片：可以左右滑動 */}
              <div class="md:w-1/2">
                <PhotoCarousel
                  images={(activity.images ?? []).map(photoOf)}
                  alt={activity.name}
                  placeholders={placeholdersFor(i)}
                  labels={{
                    prev: copy.prevPhoto,
                    next: copy.nextPhoto,
                    placeholder: copy.photoPlaceholder,
                  }}
                />
              </div>

              {/* 文字 */}
              <div class="flex flex-col justify-center md:w-1/2">
                <div class="flex items-center gap-x-3">
                  <span class="text-4xl font-bold text-yellow-400/80 tabular-nums">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="rounded-full bg-orange-400/15 px-3 py-1 text-sm font-bold text-orange-500 dark:text-orange-300">
                    {activity.time}
                  </span>
                </div>
                <h2 class="mt-3 text-2xl font-bold text-neutral-800 md:text-3xl dark:text-neutral-200">
                  {activity.name}
                </h2>
                <p class="mt-3 text-pretty text-neutral-600 md:text-lg dark:text-neutral-400">
                  {activity.description}
                </p>
                <div class="mt-6 flex flex-wrap gap-2">
                  {buttons.map(button =>
                    button.url ? (
                      <a
                        href={button.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[buttonBase, button.style]}
                      >
                        {button.label}
                        <Icon name="openInNew" class="h-4 w-4" />
                      </a>
                    ) : (
                      <span
                        class:list={[buttonBase, disabledButton]}
                        aria-disabled="true"
                        title={copy.comingSoon}
                      >
                        {button.label}
                        <Icon name="openInNew" class="h-4 w-4" />
                      </span>
                    )
                  )}
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  </Section>
</MainLayout>
