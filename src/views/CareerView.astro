---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHero from '@components/sections/landing/PageHero.astro';
import heroImage from '@images/heroes/career.jpg';
import Section from '@components/ui/blocks/Section.astro';
import SectionHeader from '@components/ui/blocks/SectionHeader.astro';
import FeatureGrid from '@components/ui/blocks/FeatureGrid.astro';
import CardInterviewRow from '@components/ui/cards/CardInterviewRow.astro';
import LinkPanel from '@components/ui/blocks/LinkPanel.astro';
import SubNav from '@components/ui/navigation/SubNav.astro';
import SwipePanels from '@components/ui/navigation/SwipePanels.astro';
import { getCopy } from '@/copy';
import { entriesFor } from '@utils/content';
import type { MarketingLocale } from '@utils/locale';

/**
 * 職涯發展：職涯訪談 → 職涯講座 → 學長姐交流 → 實習與求職資源 → 實習申請經驗。
 * 五個區塊並排成可以左右滑動的分頁，上方選單點了會切換過去，並標出目前在哪一個。
 * 每個區塊都有 id，可以用 `/career#interviews` 這種網址直接打開那一頁。
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).career;

const interviews = await entriesFor('interviews', locale);
---

<MainLayout title={copy.title} description={copy.metaDescription}>
  <PageHero
    title={copy.title}
    subTitle={copy.hero.subTitle}
    image={heroImage}
  />

  {/* 分類選單：疊在橫幅下緣，往下捲到這裡時會固定在螢幕最上方 */}
  <SubNav aria-label={copy.title} data-swipe-nav="career">
    {copy.sectionNav.map(item => (
      <a href={`#${item.id}`} class="subnav-item" data-section={item.id}>
        {item.label}
      </a>
    ))}
  </SubNav>
  {/* 可以左右滑動的分頁，一個分類一頁 */}
  <SwipePanels name="career" hint={copy.swipeHint}>
    {/* 職涯訪談 */}
    <Section id="interviews" tone="muted">
      <SectionHeader
        title={copy.interviews.title}
        subTitle={copy.interviews.subTitle}
      />
      {interviews.length === 0 ? (
        <p class="text-neutral-600 dark:text-neutral-400">
          {copy.interviews.empty}
        </p>
      ) : (
        <div class="space-y-6">
          {interviews.map(interview => (
            <CardInterviewRow interview={interview} />
          ))}
        </div>
      )}
    </Section>

    {/* 職涯講座 */}
    <Section id="talks" tone="muted">
      <SectionHeader title={copy.talks.title} subTitle={copy.talks.subTitle} />
      <FeatureGrid items={copy.talks.items} />
    </Section>

    {/* 學長姐交流 */}
    <Section id="mentorship" tone="muted">
      <SectionHeader
        title={copy.mentorship.title}
        subTitle={copy.mentorship.subTitle}
      />
      <FeatureGrid items={copy.mentorship.items} columns={2} />
    </Section>

    {/* 實習與求職資源 */}
    <Section id="jobs" tone="muted">
      <SectionHeader title={copy.jobs.title} subTitle={copy.jobs.subTitle} />
      <FeatureGrid items={copy.jobs.items} />
    </Section>

    {/* 實習申請經驗：連到外部的經驗分享（網址在 copy.career.internships.url） */}
    <Section id="internships" tone="muted">
      <LinkPanel {...copy.internships} />
    </Section>
  </SwipePanels>
</MainLayout>
