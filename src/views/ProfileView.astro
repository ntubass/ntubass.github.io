---
import MainLayout from '@/layouts/MainLayout.astro';
import Section from '@components/ui/blocks/Section.astro';
import SectionHeader from '@components/ui/blocks/SectionHeader.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * 個人資料：登入後填姓名、信箱、手機、學號並上傳學生證照片，申請成為系上同學。
 * 超級管理員在管理後台核准或退回（見 `@scripts/applications`）。不在導覽列上，
 * 從右上角的帳號選單進入；一般帳號第一次登入時也會被帶到這裡。
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).profile;
const labels = { ...copy, venuesUrl: localePath(locale, '/venues') + '#schedule' };
---

<MainLayout title={copy.title}>
  <Section tone="muted">
    <div class="mx-auto max-w-3xl" data-profile data-labels={JSON.stringify(labels)}>
      <SectionHeader title={copy.title} subTitle={copy.subTitle} />

      <p
        class="rounded-md bg-neutral-100 p-6 text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400"
        data-profile-message
      >
        {copy.notConfigured}
      </p>
      <button
        type="button"
        class="btn-sticker mt-6 hidden items-center gap-x-2 rounded-[14px] bg-neutral-50 px-5 py-3 font-black text-neutral-800"
        data-profile-signin
      >
        <Icon name="google" class="h-4 w-4" />
        {copy.signInBtn}
      </button>

      {/* 申請狀態 */}
      <div class="torn-shadow mb-10 hidden" data-profile-status>
        <div class="torn px-6 py-7 sm:px-8">
          <p class="flex flex-wrap items-center gap-3">
            <span
              class="rounded-full px-3 py-1 text-sm font-black"
              data-status-badge
            ></span>
            <span class="text-neutral-700 dark:text-neutral-300" data-status-hint></span>
          </p>
          <p class="mt-3 hidden font-bold text-orange-600 dark:text-orange-300" data-status-note></p>
          <a
            class="btn-sticker mt-5 hidden rounded-[14px] bg-orange-500 px-5 py-3 font-black text-neutral-50 hover:bg-orange-600"
            data-status-booking
          >
            {copy.goBooking}
          </a>
        </div>
      </div>

      <form class="hidden space-y-6" data-profile-form novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="profile-field">
            <span>{copy.name}</span>
            <input name="name" autocomplete="name" maxlength="40" required />
          </label>
          <label class="profile-field">
            <span>{copy.email}</span>
            <input name="email" type="email" autocomplete="email" maxlength="80" required />
          </label>
          <label class="profile-field">
            <span>{copy.phone}</span>
            <input
              name="phone"
              type="tel"
              inputmode="numeric"
              autocomplete="tel"
              maxlength="12"
              placeholder={copy.phonePlaceholder}
              required
            />
          </label>
          <label class="profile-field">
            <span>{copy.studentId}</span>
            <input
              name="studentId"
              autocapitalize="characters"
              maxlength="9"
              placeholder={copy.studentIdPlaceholder}
              required
            />
          </label>
        </div>

        {/* 學生證照片：手機上會直接開相機 */}
        <div class="profile-field">
          <span>{copy.photo}</span>
          <p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">{copy.photoHint}</p>
          <label class="photo-drop mt-2" data-photo-drop>
            <input
              type="file"
              name="photo"
              accept="image/*"
              capture="environment"
              class="sr-only"
              data-photo-input
            />
            <img class="hidden max-h-72 w-auto rounded-sm shadow-md" alt="" data-photo-preview />
            <span class="inline-flex items-center gap-x-2 font-black" data-photo-label>
              <Icon name="photo" class="h-5 w-5" />
              {copy.photoPick}
            </span>
          </label>
        </div>

        <p
          class="hidden rounded-md bg-orange-100 px-4 py-3 text-sm font-bold text-orange-700 dark:bg-orange-950 dark:text-orange-200"
          role="alert"
          data-profile-error
        >
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button
            type="submit"
            class="btn-sticker rounded-[14px] bg-orange-500 px-6 py-3.5 font-black text-neutral-50 hover:bg-orange-600 disabled:opacity-60"
            data-profile-submit
          >
            {copy.submit}
          </button>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">{copy.privacy}</p>
        </div>
      </form>
    </div>

    <div
      class="pointer-events-none fixed inset-x-0 bottom-6 z-100 flex justify-center px-4"
      aria-live="polite"
    >
      <p
        class="hidden rounded-full bg-neutral-800 px-5 py-2.5 text-sm font-bold text-neutral-50 shadow-lg dark:bg-neutral-100 dark:text-neutral-900"
        data-profile-toast
      >
      </p>
    </div>
  </Section>
</MainLayout>

<style>
  .profile-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 900;
    color: var(--color-neutral-800);
  }
  :global(.dark) .profile-field {
    color: var(--color-neutral-100);
  }
  .profile-field input:not([type='file']) {
    border-radius: 0.75rem;
    border: 2px solid var(--color-neutral-300);
    background: white;
    padding: 0.7rem 0.9rem;
    font-weight: 500;
    color: var(--color-neutral-800);
  }
  .profile-field input:focus {
    border-color: var(--color-neutral-800);
    outline: none;
    box-shadow: none;
  }
  :global(.dark) .profile-field input:not([type='file']) {
    border-color: var(--color-neutral-600);
    background: var(--color-neutral-900);
    color: var(--color-neutral-100);
  }
  .photo-drop {
    display: flex;
    min-height: 11rem;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border-radius: 0.75rem;
    border: 2px dashed var(--color-neutral-400);
    background: rgb(255 255 255 / 0.5);
    padding: 1.25rem;
    transition: border-color 150ms, background-color 150ms;
  }
  .photo-drop:hover,
  .photo-drop:focus-within {
    border-color: var(--color-neutral-800);
    background: rgb(255 255 255 / 0.8);
  }
  :global(.dark) .photo-drop {
    background: rgb(0 0 0 / 0.2);
  }
</style>

<script>
  import { hasRole, isEnabled, signIn, watchSession } from '@scripts/auth';
  import {
    compressPhoto,
    submitApplication,
    watchMyApplication,
    type Application,
  } from '@scripts/applications';

  type Labels = {
    signInFirst: string;
    status: Record<'none' | 'pending' | 'approved' | 'rejected', string>;
    statusHint: Record<'none' | 'pending' | 'approved' | 'rejected', string>;
    alreadyMember: string;
    rejectReason: string;
    photoPick: string;
    photoChange: string;
    submit: string;
    resubmit: string;
    submitting: string;
    submitted: string;
    errors: Record<'required' | 'phone' | 'studentId' | 'photo' | 'failed', string>;
    venuesUrl: string;
  };

  const root = document.querySelector<HTMLElement>('[data-profile]');
  if (root && isEnabled) {
    const labels: Labels = JSON.parse(root.dataset.labels!);
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
      document.querySelector<T>(sel)!;
    const message = $('[data-profile-message]');
    const signInBtn = $<HTMLButtonElement>('[data-profile-signin]');
    const statusBox = $('[data-profile-status]');
    const badge = $('[data-status-badge]');
    const hint = $('[data-status-hint]');
    const noteEl = $('[data-status-note]');
    const bookingLink = $<HTMLAnchorElement>('[data-status-booking]');
    const form = $<HTMLFormElement>('[data-profile-form]');
    const photoInput = $<HTMLInputElement>('[data-photo-input]');
    const preview = $<HTMLImageElement>('[data-photo-preview]');
    const photoLabel = $('[data-photo-label]');
    const errorEl = $('[data-profile-error]');
    const submitBtn = $<HTMLButtonElement>('[data-profile-submit]');
    const toastEl = $('[data-profile-toast]');
    const input = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement;

    // 直接設 display，不會被元素本身的 flex 等 class 蓋過
    const show = (node: HTMLElement, on: boolean, display = 'block') => {
      node.classList.remove('hidden');
      node.style.display = on ? display : 'none';
    };
    let toastTimer = 0;
    const toast = (text: string) => {
      toastEl.textContent = text;
      show(toastEl, true);
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => show(toastEl, false), 2800);
    };
    const setError = (msg: string) => {
      errorEl.textContent = msg;
      show(errorEl, !!msg);
    };

    bookingLink.href = labels.venuesUrl;
    signInBtn.addEventListener('click', () => signIn());

    const badgeClass: Record<string, string> = {
      none: 'bg-neutral-200 text-neutral-700',
      pending: 'bg-yellow-200 text-yellow-900',
      approved: 'bg-neutral-800 text-neutral-50',
      rejected: 'bg-orange-500 text-neutral-50',
    };

    let uid = '';
    let current: Application | null = null;
    let photo = '';
    let stopApp: (() => void) | null = null;
    let filled = false;

    const setPhoto = (url: string) => {
      photo = url;
      preview.src = url;
      show(preview, !!url);
      photoLabel.lastChild!.textContent = url ? labels.photoChange : labels.photoPick;
    };

    const render = (alreadyMember: boolean) => {
      const status = current?.status ?? 'none';
      show(statusBox, true);
      badge.className = `rounded-full px-3 py-1 text-sm font-black ${badgeClass[status]}`;
      badge.textContent = labels.status[status];
      hint.textContent =
        alreadyMember && status !== 'approved'
          ? labels.alreadyMember
          : labels.statusHint[status];
      noteEl.textContent = current?.note ? labels.rejectReason + current.note : '';
      show(noteEl, status === 'rejected' && !!current?.note);
      show(bookingLink, alreadyMember || status === 'approved', 'inline-flex');
      // 已核准或本來就是系上同學以上的人不用再填
      show(form, !alreadyMember && status !== 'approved');
      submitBtn.textContent = status === 'none' ? labels.submit : labels.resubmit;
    };

    watchSession(session => {
      stopApp?.();
      stopApp = null;
      show(signInBtn, !session, 'inline-flex');
      message.textContent = labels.signInFirst;
      show(message, !session);
      if (!session) {
        show(statusBox, false);
        show(form, false);
        return;
      }
      uid = session.user.uid;
      const alreadyMember = hasRole(session, 'student');
      stopApp = watchMyApplication(
        uid,
        app => {
          current = app;
          // 第一次載入時帶入資料：有申請過就用申請的內容，沒有就用 Google 帳號的名字和信箱
          if (!filled) {
            filled = true;
            input('name').value = app?.name || session.user.displayName || '';
            input('email').value = app?.email || session.user.email || '';
            input('phone').value = app?.phone ?? '';
            input('studentId').value = app?.studentId ?? '';
            setPhoto(app?.photo ?? '');
          }
          render(alreadyMember);
        },
        err => {
          console.error(err);
          setError(labels.errors.failed);
        }
      );
    });

    photoInput.addEventListener('change', async () => {
      const file = photoInput.files?.[0];
      if (!file) return;
      setError('');
      try {
        setPhoto(await compressPhoto(file));
      } catch (err) {
        console.error(err);
        setError(labels.errors.photo);
      }
    });

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const data = {
        name: input('name').value.trim(),
        email: input('email').value.trim(),
        phone: input('phone').value.replace(/[\s-]/g, ''),
        studentId: input('studentId').value.trim().toUpperCase(),
        photo,
      };
      if (Object.values(data).some(v => !v)) return setError(labels.errors.required);
      if (!/^09\d{8}$/.test(data.phone)) return setError(labels.errors.phone);
      if (!/^[A-Z]\d{2}[A-Z0-9]\d{5}$/.test(data.studentId))
        return setError(labels.errors.studentId);
      setError('');
      submitBtn.disabled = true;
      submitBtn.textContent = labels.submitting;
      try {
        await submitApplication(uid, data);
        toast(labels.submitted);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        setError(labels.errors.failed);
      } finally {
        submitBtn.disabled = false;
        render(false);
      }
    });
  }
</script>
