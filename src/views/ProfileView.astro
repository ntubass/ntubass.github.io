---
import MainLayout from '@/layouts/MainLayout.astro';
import Section from '@components/ui/blocks/Section.astro';
import SectionHeader from '@components/ui/blocks/SectionHeader.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * 個人資料：登入後填姓名、手機與學號，寄驗證碼到「學號@ntu.edu.tw」，
 * 輸入正確就自動成為系上同學（見 `@scripts/verification` 與 apps-script/verify.gs）。
 * 不在導覽列上，從右上角的帳號選單進入；一般帳號登入時也會被帶到這裡。
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).profile;
const labels = { ...copy, venuesUrl: localePath(locale, '/venues') + '#schedule' };
---

<MainLayout title={copy.title}>
  <Section tone="muted">
    <div class="mx-auto max-w-3xl" data-profile data-labels={JSON.stringify(labels)}>
      <SectionHeader title={copy.title} subTitle={copy.subTitle} />

      <p
        class="rounded-md bg-neutral-100 p-6 text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400"
        data-profile-message
      >
        {copy.notConfigured}
      </p>
      <button
        type="button"
        class="btn-sticker mt-6 hidden items-center gap-x-2 rounded-[14px] bg-neutral-50 px-5 py-3 font-black text-neutral-800"
        data-profile-signin
      >
        <Icon name="google" class="h-4 w-4" />
        {copy.signInBtn}
      </button>

      {/* 驗證狀態 */}
      <div class="torn-shadow mb-10 hidden" data-profile-status>
        <div class="torn px-6 py-7 sm:px-8">
          <p class="flex flex-wrap items-center gap-3">
            <span class="rounded-full px-3 py-1 text-sm font-black" data-status-badge></span>
            <span class="text-neutral-700 dark:text-neutral-300" data-status-hint></span>
          </p>
          {/* 已驗證：顯示填過的資料 */}
          <dl
            class="mt-5 hidden grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm"
            data-profile-summary
          >
            <dt class="font-bold text-neutral-500 dark:text-neutral-400">{copy.name}</dt>
            <dd data-summary="name"></dd>
            <dt class="font-bold text-neutral-500 dark:text-neutral-400">{copy.phone}</dt>
            <dd data-summary="phone"></dd>
            <dt class="font-bold text-neutral-500 dark:text-neutral-400">{copy.studentId}</dt>
            <dd data-summary="studentId"></dd>
            <dt class="font-bold text-neutral-500 dark:text-neutral-400">Email</dt>
            <dd class="break-all" data-summary="ntuEmail"></dd>
          </dl>
          <a
            class="btn-sticker mt-6 hidden rounded-[14px] bg-orange-500 px-5 py-3 font-black text-neutral-50 hover:bg-orange-600"
            data-status-booking
          >
            {copy.goBooking}
          </a>
        </div>
      </div>

      <form class="hidden space-y-6" data-profile-form novalidate>
        {/* 步驟 1：基本資料與學號 */}
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="profile-field">
            <span>{copy.name}</span>
            <input name="name" autocomplete="name" maxlength="40" required />
          </label>
          <label class="profile-field">
            <span>{copy.phone}</span>
            <input
              name="phone"
              type="tel"
              inputmode="numeric"
              autocomplete="tel"
              maxlength="12"
              placeholder={copy.phonePlaceholder}
              required
            />
          </label>
          <label class="profile-field sm:col-span-2">
            <span>{copy.studentId}</span>
            <input
              name="studentId"
              autocapitalize="characters"
              autocomplete="off"
              maxlength="9"
              placeholder={copy.studentIdPlaceholder}
              required
            />
            <small class="font-medium text-neutral-600 dark:text-neutral-400">{copy.studentIdHint}</small>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-4" data-step-send>
          <button
            type="button"
            class="btn-sticker rounded-[14px] bg-orange-500 px-6 py-3.5 font-black text-neutral-50 hover:bg-orange-600 disabled:opacity-60"
            data-send
          >
            {copy.sendCode}
          </button>
        </div>

        {/* 步驟 2：輸入驗證碼 */}
        <div class="hidden space-y-4 rounded-md border-2 border-dashed border-neutral-400 p-5 dark:border-neutral-600" data-step-verify>
          <p class="font-bold text-neutral-800 dark:text-neutral-100" data-sent-to></p>
          <p class="hidden rounded-md bg-yellow-200 px-3 py-2 text-sm font-black text-yellow-900" data-demo-code></p>
          <label class="profile-field max-w-xs">
            <span>{copy.code}</span>
            <input
              name="code"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="6"
              placeholder={copy.codePlaceholder}
              class="tracking-[0.3em] placeholder-shown:tracking-normal"
            />
          </label>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <button
              type="submit"
              class="btn-sticker rounded-[14px] bg-orange-500 px-6 py-3.5 font-black text-neutral-50 hover:bg-orange-600 disabled:opacity-60"
              data-verify
            >
              {copy.verify}
            </button>
            <button
              type="button"
              class="text-sm font-bold text-neutral-700 underline decoration-yellow-500 decoration-2 underline-offset-4 disabled:no-underline disabled:opacity-60 dark:text-neutral-300"
              data-resend
            >
              {copy.resend}
            </button>
            <button
              type="button"
              class="text-sm font-bold text-neutral-700 underline decoration-yellow-500 decoration-2 underline-offset-4 dark:text-neutral-300"
              data-change-id
            >
              {copy.changeStudentId}
            </button>
          </div>
        </div>

        <p
          class="hidden rounded-md bg-orange-100 px-4 py-3 text-sm font-bold text-orange-700 dark:bg-orange-950 dark:text-orange-200"
          role="alert"
          data-profile-error
        >
        </p>

        <p class="text-sm text-neutral-600 dark:text-neutral-400">{copy.privacy}</p>
      </form>
    </div>

    <div
      class="pointer-events-none fixed inset-x-0 bottom-6 z-100 flex justify-center px-4"
      aria-live="polite"
    >
      <p
        class="hidden rounded-full bg-neutral-800 px-5 py-2.5 text-sm font-bold text-neutral-50 shadow-lg dark:bg-neutral-100 dark:text-neutral-900"
        data-profile-toast
      >
      </p>
    </div>
  </Section>
</MainLayout>

<style>
  .profile-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 900;
    color: var(--color-neutral-800);
  }
  :global(.dark) .profile-field {
    color: var(--color-neutral-100);
  }
  .profile-field input {
    border-radius: 0.75rem;
    border: 2px solid var(--color-neutral-300);
    background: white;
    padding: 0.7rem 0.9rem;
    font-weight: 500;
    color: var(--color-neutral-800);
  }
  .profile-field input:focus {
    border-color: var(--color-neutral-800);
    outline: none;
    box-shadow: none;
  }
  .profile-field input[readonly] {
    background: var(--color-neutral-100);
    color: var(--color-neutral-600);
  }
  :global(.dark) .profile-field input {
    border-color: var(--color-neutral-600);
    background: var(--color-neutral-900);
    color: var(--color-neutral-100);
  }
</style>

<script>
  import { hasRole, isEnabled, signIn, watchSession } from '@scripts/auth';
  import {
    VerifyFailure,
    confirmVerificationCode,
    sendVerificationCode,
    verificationReady,
    watchMyProfile,
    type Profile,
  } from '@scripts/verification';

  type Labels = {
    signInFirst: string;
    notReady: string;
    status: Record<'none' | 'approved', string>;
    statusHint: Record<'none' | 'approved', string>;
    alreadyMember: string;
    sendCode: string;
    sending: string;
    resend: string;
    resendIn: string;
    sentTo: string;
    demoCode: string;
    verify: string;
    verifying: string;
    verified: string;
    errors: Record<string, string>;
    venuesUrl: string;
  };

  const root = document.querySelector<HTMLElement>('[data-profile]');
  if (root && isEnabled) {
    const labels: Labels = JSON.parse(root.dataset.labels!);
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
      document.querySelector<T>(sel)!;
    const message = $('[data-profile-message]');
    const signInBtn = $<HTMLButtonElement>('[data-profile-signin]');
    const statusBox = $('[data-profile-status]');
    const badge = $('[data-status-badge]');
    const hint = $('[data-status-hint]');
    const summary = $('[data-profile-summary]');
    const bookingLink = $<HTMLAnchorElement>('[data-status-booking]');
    const form = $<HTMLFormElement>('[data-profile-form]');
    const stepSend = $('[data-step-send]');
    const stepVerify = $('[data-step-verify]');
    const sendBtn = $<HTMLButtonElement>('[data-send]');
    const verifyBtn = $<HTMLButtonElement>('[data-verify]');
    const resendBtn = $<HTMLButtonElement>('[data-resend]');
    const changeIdBtn = $<HTMLButtonElement>('[data-change-id]');
    const sentTo = $('[data-sent-to]');
    const demoCode = $('[data-demo-code]');
    const errorEl = $('[data-profile-error]');
    const toastEl = $('[data-profile-toast]');
    const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

    // 直接設 display，不會被元素本身的 flex 等 class 蓋過
    const show = (node: HTMLElement, on: boolean, display = 'block') => {
      node.classList.remove('hidden');
      node.style.display = on ? display : 'none';
    };
    let toastTimer = 0;
    const toast = (text: string) => {
      toastEl.textContent = text;
      show(toastEl, true);
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => show(toastEl, false), 3000);
    };
    const setError = (msg: string) => {
      errorEl.textContent = msg;
      show(errorEl, !!msg);
    };
    const errorText = (err: unknown) => {
      if (err instanceof VerifyFailure) {
        const text = labels.errors[err.code] ?? labels.errors.server;
        return text.replace('{n}', String(err.left ?? 0));
      }
      console.error(err);
      return labels.errors.server;
    };

    bookingLink.href = labels.venuesUrl;
    signInBtn.addEventListener('click', () => signIn());

    let uid = '';
    let stopProfile: (() => void) | null = null;
    let filled = false;

    // --- 重新寄送的倒數 ---
    let cooldownTimer = 0;
    const startCooldown = (seconds = 60) => {
      clearInterval(cooldownTimer);
      let left = seconds;
      const tick = () => {
        resendBtn.disabled = left > 0;
        resendBtn.textContent = left > 0 ? labels.resendIn.replace('{n}', String(left)) : labels.resend;
        left -= 1;
        if (left < -1) clearInterval(cooldownTimer);
      };
      tick();
      cooldownTimer = window.setInterval(tick, 1000);
    };

    const setStep = (step: 'send' | 'verify') => {
      show(stepSend, step === 'send', 'flex');
      show(stepVerify, step === 'verify');
      input('studentId').readOnly = step === 'verify';
    };

    const render = (profile: Profile | null, alreadyMember: boolean) => {
      const verified = !!profile;
      show(statusBox, true);
      badge.className = `rounded-full px-3 py-1 text-sm font-black ${verified ? 'bg-neutral-800 text-neutral-50' : 'bg-neutral-200 text-neutral-700'}`;
      badge.textContent = labels.status[verified ? 'approved' : 'none'];
      hint.textContent = verified
        ? labels.statusHint.approved
        : alreadyMember
          ? labels.alreadyMember
          : verificationReady
            ? labels.statusHint.none
            : labels.notReady;
      show(summary, verified, 'grid');
      if (profile)
        (['name', 'phone', 'studentId', 'ntuEmail'] as const).forEach(key => {
          summary.querySelector(`[data-summary="${key}"]`)!.textContent = profile[key];
        });
      show(bookingLink, verified || alreadyMember, 'inline-flex');
      show(form, !verified && !alreadyMember && verificationReady);
    };

    watchSession(session => {
      stopProfile?.();
      stopProfile = null;
      show(signInBtn, !session, 'inline-flex');
      message.textContent = labels.signInFirst;
      show(message, !session);
      if (!session) {
        show(statusBox, false);
        show(form, false);
        return;
      }
      uid = session.user.uid;
      const alreadyMember = hasRole(session, 'student');
      if (!filled) {
        filled = true;
        input('name').value = session.user.displayName ?? '';
        setStep('send');
      }
      stopProfile = watchMyProfile(
        uid,
        profile => render(profile, alreadyMember),
        err => {
          console.error(err);
          setError(labels.errors.server);
        }
      );
    });

    const readForm = () => ({
      name: input('name').value.trim(),
      phone: input('phone').value.replace(/[\s-]/g, ''),
      studentId: input('studentId').value.trim().toUpperCase(),
    });

    // --- 步驟 1：寄驗證碼 ---
    const send = async (button: HTMLButtonElement) => {
      const data = readForm();
      if (!data.name || !data.phone || !data.studentId) return setError(labels.errors.required);
      if (!/^09\d{8}$/.test(data.phone)) return setError(labels.errors.phone);
      setError('');
      const original = button.textContent;
      button.disabled = true;
      button.textContent = labels.sending;
      try {
        const result = await sendVerificationCode(data.studentId);
        input('studentId').value = data.studentId;
        sentTo.textContent = labels.sentTo.replace('{email}', result.email);
        demoCode.textContent = result.demoCode ? labels.demoCode.replace('{code}', result.demoCode) : '';
        show(demoCode, !!result.demoCode);
        setStep('verify');
        input('code').value = '';
        input('code').focus();
        startCooldown();
      } catch (err) {
        setError(errorText(err));
      } finally {
        button.disabled = false;
        button.textContent = original;
        if (button === resendBtn && stepVerify.style.display !== 'none') startCooldown();
      }
    };
    sendBtn.addEventListener('click', () => send(sendBtn));
    resendBtn.addEventListener('click', () => send(resendBtn));
    changeIdBtn.addEventListener('click', () => {
      setError('');
      setStep('send');
      input('studentId').focus();
    });

    // --- 步驟 2：完成驗證 ---
    form.addEventListener('submit', async e => {
      e.preventDefault();
      if (stepVerify.style.display === 'none') return send(sendBtn);
      const code = input('code').value.trim();
      if (!/^\d{6}$/.test(code)) return setError(labels.errors.codeRequired);
      const data = readForm();
      if (!data.name || !/^09\d{8}$/.test(data.phone)) return setError(labels.errors.phone);
      setError('');
      verifyBtn.disabled = true;
      verifyBtn.textContent = labels.verifying;
      try {
        await confirmVerificationCode(uid, { code, name: data.name, phone: data.phone });
        toast(labels.verified);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (err) {
        setError(errorText(err));
      } finally {
        verifyBtn.disabled = false;
        verifyBtn.textContent = labels.verify;
      }
    });
  }
</script>
