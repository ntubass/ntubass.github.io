---
import MainLayout from '@/layouts/MainLayout.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import Section from '@components/ui/blocks/Section.astro';
import SectionHeader from '@components/ui/blocks/SectionHeader.astro';
import ArrowLink from '@components/ui/links/ArrowLink.astro';
import TeamGrid from '@components/sections/about/TeamGrid.astro';
import PageHero from '@components/sections/landing/PageHero.astro';
import heroImage from '@images/heroes/home.jpg';
import FAQ from '@components/sections/misc/FAQ.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { RECRUIT } from '@data/recruit';
import { activities } from '@data/activities';
import { departments } from '@data/team';
import { venues } from '@data/venues';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * 首頁，區塊由上到下：
 * Hero → 系學會在做什麼（含數字）→ 我們重視的事 → 活動成果
 * → 幹部團隊 → 幹部心得 → 常見問題
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;

// 首頁的數字由網站上的資料自動計算，資料改了數字就會跟著變
const stats = [
  { value: activities.length, label: copy.mission.statLabels.activities },
  { value: departments.length, label: copy.mission.statLabels.departments },
  { value: venues.length, label: copy.mission.statLabels.venues },
  { value: t.resources.sections.length, label: copy.mission.statLabels.fields },
];
---

<MainLayout>
  {RECRUIT.isOpen && (
    <AnnouncementBanner
      btnId="recruit-banner-dismiss"
      title={copy.banner.text}
      btnTitle={copy.banner.btn}
      url={localePath(locale, '/about-us#recruit')}
    />
  )}

  {/* Hero：照片在 src/images/heroes/home.jpg */}
  <PageHero
    title={copy.hero.title}
    subTitle={copy.hero.subTitle}
    image={heroImage}
    size="lg"
  >
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:justify-center">
      <PrimaryCTA
        title={copy.hero.primaryBtn}
        url={localePath(locale, '/activities')}
      />
      <SecondaryCTA
        title={copy.hero.secondaryBtn}
        url={localePath(locale, '/about-us#recruit')}
      />
    </div>
  </PageHero>

  {/* 系學會在做什麼 + 數字：左邊是介紹，右邊是 2×2 的大數字 */}
  <Section tone="muted">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHeader title={copy.mission.title} />
        <p class="-mt-4 max-w-xl text-lg leading-[1.9] text-neutral-700 dark:text-neutral-300">
          {copy.mission.body}
        </p>
      </div>
      <dl class="grid grid-cols-2 self-end lg:col-span-6">
        {stats.map((stat, i) => (
          <div
            class:list={[
              'flex flex-col gap-2 border-neutral-300 py-7 dark:border-neutral-700',
              i % 2 === 1 && 'border-l ps-6 sm:ps-10',
              i < 2 && 'border-b',
            ]}
          >
            <dt class="text-sm font-medium text-neutral-600 dark:text-neutral-400">
              {stat.label}
            </dt>
            <dd class="num order-first text-6xl font-extrabold text-neutral-900 lg:text-7xl dark:text-neutral-50">
              {stat.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  {/* 我們重視的事：左邊標題固定，右邊是編號清單 */}
  <Section>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <SectionHeader
            title={copy.values.title}
            subTitle={copy.values.subTitle}
          />
        </div>
      </div>
      <ol class="lg:col-span-8">
        {copy.values.items.map((item, i) => (
          <li class="group grid grid-cols-[auto_1fr] gap-x-6 border-t border-neutral-300 py-8 first:border-t-0 first:pt-0 sm:gap-x-10 dark:border-neutral-800">
            <span class="num text-5xl font-extrabold text-yellow-400 transition-transform duration-300 group-hover:-translate-y-1 sm:text-6xl">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pt-1">
              <h3 class="flex items-center gap-x-3 text-2xl text-neutral-900 sm:text-3xl dark:text-neutral-50">
                <Icon name={item.icon} class="h-6 w-6 text-orange-500 dark:text-orange-300" />
                {item.title}
              </h3>
              <p class="mt-3 max-w-xl leading-[1.85] text-neutral-600 dark:text-neutral-400">
                {item.description}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  {/* 活動成果：一條橫向時間軸，每個活動一個點 */}
  {activities.length > 0 && (
    <Section tone="muted">
      <SectionHeader title={copy.events.title} subTitle={copy.events.subTitle}>
        <ArrowLink
          url={localePath(locale, '/activities')}
          title={copy.events.cta}
        />
      </SectionHeader>
      <ol class="relative grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 lg:grid-cols-7 lg:gap-y-0">
        {/* 時間軸的線（只在電腦版一整排時顯示） */}
        <span
          class="absolute inset-x-0 top-[0.4375rem] hidden h-px bg-neutral-400/60 lg:block dark:bg-neutral-700"
          aria-hidden="true"
        />
        {activities.map(activity => (
          <li class="relative">
            <a
              href={localePath(locale, `/activities#${activity.id}`)}
              class="group block rounded-xl pe-2"
            >
              <span class="relative block h-3.5 w-3.5 rounded-full border-[3px] border-neutral-200 bg-yellow-400 transition-transform duration-300 group-hover:scale-125 dark:border-neutral-900" />
              <span class="num mt-5 block text-sm font-semibold text-orange-500 dark:text-orange-300">
                {activity.time}
              </span>
              <span class="mt-1 block font-serif text-xl font-black text-neutral-900 transition-colors group-hover:text-orange-500 dark:text-neutral-50 dark:group-hover:text-orange-300">
                {activity.name}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </Section>
  )}

  {/* 幹部團隊 */}
  <Section>
    <SectionHeader title={copy.team.title} subTitle={copy.team.subTitle}>
      <ArrowLink url={localePath(locale, '/about-us')} title={copy.team.cta} />
    </SectionHeader>
    <TeamGrid compact />
  </Section>

  {/* 幹部心得：第一則放大當主角，其他兩則疊在右邊 */}
  <Section tone="muted">
    <SectionHeader
      title={copy.testimonials.title}
      subTitle={copy.testimonials.subTitle}
    />
    <div class="grid gap-6 lg:grid-cols-12">
      {copy.testimonials.quotes.map((quote, i) => (
        <figure
          class:list={[
            'flex flex-col rounded-[1.5rem]',
            i === 0
              ? 'bg-neutral-900 p-8 text-neutral-50 sm:p-12 lg:col-span-7 lg:row-span-2 dark:bg-neutral-50 dark:text-neutral-900'
              : 'bg-neutral-50 p-7 lg:col-span-5 dark:bg-neutral-800',
          ]}
        >
          <Icon
            name="quotation"
            class:list={[
              'text-yellow-400',
              i === 0 ? 'h-10 w-10' : 'h-7 w-7',
            ]}
          />
          <blockquote
            class:list={[
              'mt-5 grow',
              i === 0
                ? 'font-serif text-2xl leading-[1.6] font-semibold sm:text-[1.75rem]'
                : 'leading-[1.85] text-neutral-700 dark:text-neutral-300',
            ]}
          >
            {quote.content}
          </blockquote>
          <figcaption class="mt-8 flex items-center gap-x-3">
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-[14px] bg-yellow-400 font-serif font-black text-neutral-900"
              aria-hidden="true"
            >
              {quote.author.charAt(0)}
            </span>
            <span>
              <span class="block font-bold">{quote.author}</span>
              <span
                class:list={[
                  'block text-sm',
                  i === 0
                    ? 'text-neutral-400 dark:text-neutral-600'
                    : 'text-neutral-500 dark:text-neutral-400',
                ]}
              >
                {quote.role}
              </span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <FAQ id="faq" title={t.faq.title} subTitle={t.faq.subTitle} faqs={t.faq.faqs} />
</MainLayout>
