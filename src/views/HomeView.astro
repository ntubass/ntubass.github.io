---
import MainLayout from '@/layouts/MainLayout.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import Section from '@components/ui/blocks/Section.astro';
import SectionHeader from '@components/ui/blocks/SectionHeader.astro';
import FeatureGrid from '@components/ui/blocks/FeatureGrid.astro';
import ArrowLink from '@components/ui/links/ArrowLink.astro';
import TeamGrid from '@components/sections/about/TeamGrid.astro';
import HomeHero from '@components/sections/landing/HomeHero.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import { RECRUIT } from '@data/recruit';
import { activities } from '@data/activities';
import { departments } from '@data/team';
import { venues } from '@data/venues';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * 首頁，區塊由上到下：
 * Hero → 系學會在做什麼（含數字）→ 我們重視的事 → 活動成果
 * → 幹部團隊 → 常見問題
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;

// 首頁的數字由網站上的資料自動計算，資料改了數字就會跟著變
const stats = [
  { value: activities.length, label: copy.mission.statLabels.activities },
  { value: departments.length, label: copy.mission.statLabels.departments },
  { value: venues.length, label: copy.mission.statLabels.venues },
  { value: t.resources.sections.length, label: copy.mission.statLabels.fields },
];
---

<MainLayout>
  {RECRUIT.isOpen && (
    <AnnouncementBanner
      btnId="recruit-banner-dismiss"
      title={copy.banner.text}
      btnTitle={copy.banner.btn}
      url={localePath(locale, '/about-us#recruit')}
    />
  )}

  {/* Hero：拍立得拼貼，照片在 src/data_files/hero.ts 設定 */}
  <HomeHero title={copy.hero.title} subTitle={copy.hero.subTitle}>
    <PrimaryCTA
      title={copy.hero.primaryBtn}
      url={localePath(locale, '/activities')}
    />
    <SecondaryCTA
      title={copy.hero.secondaryBtn}
      url={localePath(locale, '/about-us#recruit')}
    />
  </HomeHero>

  {/* 系學會在做什麼 + 數字 */}
  <Section tone="muted">
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeader title={copy.mission.title} align="center" />
      <p class="-mt-4 text-lg leading-relaxed text-pretty text-neutral-700 dark:text-neutral-300">
        {copy.mission.body}
      </p>
    </div>
    <dl class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {stats.map(stat => (
          <div class="flex flex-col rounded-2xl bg-neutral-50 p-6 text-center dark:bg-neutral-800">
            <dt class="text-sm text-neutral-600 dark:text-neutral-400">
              {stat.label}
            </dt>
            <dd class="order-first text-3xl font-bold text-orange-400 lg:text-4xl dark:text-orange-300">
              {stat.value}
            </dd>
          </div>
        ))}
    </dl>
  </Section>

  {/* 我們重視的事 */}
  <Section>
    <SectionHeader
      title={copy.values.title}
      subTitle={copy.values.subTitle}
      align="center"
    />
    <FeatureGrid items={copy.values.items} align="center" />
  </Section>

  {/* 活動成果 */}
  {activities.length > 0 && (
    <Section tone="muted">
      <SectionHeader
        title={copy.events.title}
        subTitle={copy.events.subTitle}
        align="center"
      >
        <ArrowLink
          url={localePath(locale, '/activities')}
          title={copy.events.cta}
        />
      </SectionHeader>
      {/* 精簡版時間軸：每個活動一格，點了跳到活動成果頁的那個活動 */}
      <ol class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-7">
        {activities.map((activity, i) => (
          <li>
            <a
              href={localePath(locale, `/activities#${activity.id}`)}
              class="group block h-full rounded-2xl border border-neutral-300/60 bg-neutral-50 p-4 text-center transition hover:-translate-y-1 hover:shadow-md dark:border-neutral-700 dark:bg-neutral-900/50"
            >
              <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-yellow-400 text-sm font-bold text-neutral-800">
                {i + 1}
              </span>
              <span class="mt-2 block text-xs font-semibold text-orange-400 dark:text-orange-300">
                {activity.time}
              </span>
              <span class="mt-1 block font-bold text-neutral-800 group-hover:text-orange-400 dark:text-neutral-200 dark:group-hover:text-orange-300">
                {activity.name}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </Section>
  )}

  {/* 幹部團隊 */}
  <Section>
    <SectionHeader
      title={copy.team.title}
      subTitle={copy.team.subTitle}
      align="center"
    >
      <ArrowLink url={localePath(locale, '/about-us')} title={copy.team.cta} />
    </SectionHeader>
    <TeamGrid compact centered />
  </Section>

  <FAQ id="faq" title={t.faq.title} subTitle={t.faq.subTitle} faqs={t.faq.faqs} />
</MainLayout>
