---
import { Image } from 'astro:assets';
import { SITE } from '@data/constants';
import logo from '@images/brand/logo.jpg';

/**
 * 品牌字標：圓形 logo（`src/images/brand/logo.jpg`）+ 系學會名稱。
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['inline-flex min-w-0 items-center gap-x-3 leading-tight', className]}>
  <Image
    src={logo}
    alt=""
    width={88}
    height={88}
    class="h-11 w-11 shrink-0 rounded-full object-cover shadow-[0_0_0_3px_var(--color-paper-warm)]"
  />
  {/* 1024–1279px 放不下名稱 + 7 個連結 + 帳號選單，只顯示 logo；連結本身有 aria-label（1024 以下是選單按鈕版面） */}
  <span class="min-w-0 text-[0.95rem] font-black tracking-tight text-balance text-neutral-800 sm:text-[1.05rem] lg:hidden xl:inline xl:whitespace-nowrap dark:text-neutral-100">
    {SITE.title}
  </span>
</span>
