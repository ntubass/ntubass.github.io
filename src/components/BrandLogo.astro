---
import { SITE } from '@data/constants';

/**
 * 文字版 logo：系學會名稱。
 * 有圖片 logo 的話，可以把這裡換成 <Image src={logo} alt={SITE.title} />。
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['inline-flex leading-tight', className]}>
  <span class="text-lg font-bold tracking-tight text-neutral-800 dark:text-neutral-200">
    {SITE.title}
  </span>
</span>
