---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import { SITE } from '@data/constants';
import { navLinks, socialLinks } from '@data/navigation';
import { localePath } from '@utils/locale';

const { locale, copy: t } = Astro.locals;
const footer = t.nav.footer;

const linkClass =
  'inline-flex gap-x-2 rounded-lg text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-300 dark:focus:outline-hidden';
const socialIconClass =
  'h-5 w-5 shrink-0 text-neutral-700 dark:text-neutral-400';

const socials = [
  { url: socialLinks.instagram, label: 'Instagram', icon: 'instagram' },
  { url: socialLinks.facebook, label: 'Facebook', icon: 'facebook' },
  { url: socialLinks.linkedIn, label: 'LinkedIn', icon: 'linkedIn' },
] as const;
---

<footer class="paper-sheet mt-10 w-full">
  <div class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-16 2xl:max-w-(--breakpoint-2xl)">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div>
        <BrandLogo />
        <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">
          {SITE.tagline}
        </p>
      </div>

      <div>
        <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
          {footer.quickLinks}
        </h3>
        <ul class="mt-3 grid grid-cols-2 gap-3">
          {navLinks.map(link => (
            <li>
              <a href={localePath(locale, link.path)} class={linkClass}>
                {t.nav.labels[link.id]}
              </a>
            </li>
          ))}
          <li>
            <a href={localePath(locale, '/#faq')} class={linkClass}>
              {footer.faq}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
          {footer.contact}
        </h3>
        <a href={`mailto:${SITE.email}`} class:list={[linkClass, 'mt-3']}>
          <Icon name="envelopeOpen" class="h-5 w-5 shrink-0" />
          {SITE.email}
        </a>
        <h3 class="mt-6 font-bold text-neutral-800 dark:text-neutral-200">
          {footer.followUs}
        </h3>
        <div class="mt-2 -ms-2.5">
          {socials
            .filter(social => social.url)
            .map(social => (
              <FooterSocialLink url={social.url} label={social.label}>
                <Icon
                  name={social.icon}
                  class={socialIconClass}
                  title={social.label}
                />
              </FooterSocialLink>
            ))}
        </div>
      </div>
    </div>

    <p class="mt-10 border-t border-neutral-400/40 pt-6 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">
      © <span id="current-year"></span>
      {` ${[SITE.title, SITE.term, footer.rights].filter(Boolean).join(' ')}`}
    </p>

    <script>
      const element = document.getElementById('current-year');
      if (element) element.innerText = new Date().getFullYear().toString();
    </script>
  </div>
</footer>
