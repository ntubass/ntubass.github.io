---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * 頁面開頭的大橫幅（首頁與各內頁共用）：背景照片 + 暖色漸層遮罩，標題置中、白字。
 * default slot 放在說明文字下方（按鈕、分頁按鈕等）。
 *
 * - `image`：背景照片。照片放在 `src/images/heroes/`，在 view 裡 import 後傳進來。
 *   沒給照片時會改用黃色系的漸層底，版面一樣完整。
 * - `size`：`lg` 是首頁用的較高版本，其他頁用預設的 `md`。
 */
interface Props {
  title: string;
  subTitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  size?: 'md' | 'lg';
}

const { title, subTitle, image, imageAlt = '', size = 'md' } = Astro.props;
const isLarge = size === 'lg';
---

<section
  class:list={[
    'relative isolate mx-auto mt-6 flex max-w-[85rem] flex-col items-center justify-center overflow-hidden rounded-3xl px-6 text-center sm:px-10 2xl:max-w-full',
    isLarge ? 'min-h-[75svh] py-24' : 'min-h-[52svh] py-20',
    !image && 'bg-linear-to-br from-yellow-300 via-yellow-400 to-orange-400',
  ]}
>
  {image && (
    <>
      <Image
        src={image}
        alt={imageAlt}
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1024, 1600, 2000]}
        sizes="(min-width: 1360px) 1360px, 100vw"
      />
      {/* 遮罩：上淺下深的暗色漸層，再疊一層淡淡的暖色，讓照片和網站的黃橘色調一致 */}
      <div
        class="absolute inset-0 -z-10 bg-linear-to-b from-neutral-900/35 via-neutral-900/55 to-neutral-900/80"
        aria-hidden="true"
      />
      <div
        class="absolute inset-0 -z-10 bg-linear-to-tr from-orange-500/25 via-transparent to-yellow-400/20 mix-blend-multiply"
        aria-hidden="true"
      />
    </>
  )}

  <h1
    class:list={[
      'max-w-4xl font-bold tracking-tight text-balance drop-shadow-sm',
      isLarge
        ? 'text-3xl sm:text-5xl lg:text-6xl lg:leading-tight'
        : 'text-3xl sm:text-4xl lg:text-5xl lg:leading-tight',
      image ? 'text-neutral-50' : 'text-neutral-800',
    ]}
  >
    <Fragment set:html={title} />
  </h1>
  <span
    class:list={[
      'mt-5 block h-1 w-16 rounded-full',
      image ? 'bg-yellow-400' : 'bg-neutral-800/70',
    ]}
    aria-hidden="true"
  />
  {subTitle && (
    <p
      class:list={[
        'mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-pretty',
        image ? 'text-neutral-100' : 'text-neutral-800/80',
      ]}
    >
      {subTitle}
    </p>
  )}
  {Astro.slots.has('default') && (
    <div class="mt-8 flex w-full justify-center">
      <slot />
    </div>
  )}
</section>
