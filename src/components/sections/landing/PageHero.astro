---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * 頁面開頭的大橫幅（首頁與各內頁共用）：背景照片 + 由下往上的深色漸層，
 * 標題靠左、貼近底部，像刊物封面。
 * default slot 放在說明文字下方（按鈕、分頁按鈕等）。
 *
 * - `image`：背景照片。照片放在 `src/images/heroes/`，在 view 裡 import 後傳進來。
 *   沒給照片時會改用黃色系的漸層底，版面一樣完整。
 * - `size`：`lg` 是首頁用的較高版本，其他頁用預設的 `md`。
 */
interface Props {
  title: string;
  subTitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  size?: 'md' | 'lg';
}

const { title, subTitle, image, imageAlt = '', size = 'md' } = Astro.props;
const isLarge = size === 'lg';
---

<section
  class:list={[
    'relative isolate mx-auto mt-6 flex max-w-[85rem] flex-col items-start justify-end overflow-hidden rounded-[2rem] px-6 text-left sm:px-12 lg:px-16 2xl:max-w-full',
    isLarge ? 'min-h-[82svh] pt-32 pb-14 lg:pb-20' : 'min-h-[48svh] pt-28 pb-12 lg:pb-16',
    !image && 'bg-linear-to-br from-yellow-300 via-yellow-400 to-yellow-500',
  ]}
>
  {image && (
    <>
      <Image
        src={image}
        alt={imageAlt}
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1024, 1600, 2000]}
        sizes="(min-width: 1360px) 1360px, 100vw"
      />
      {/* 遮罩：底部與左側較深，讓左下角的白字清楚；上方保留照片原本的樣子 */}
      <div
        class="absolute inset-0 -z-10 bg-linear-to-t from-neutral-950/90 via-neutral-950/45 to-neutral-950/5"
        aria-hidden="true"
      />
      <div
        class="absolute inset-0 -z-10 bg-linear-to-r from-neutral-950/55 via-neutral-950/10 to-transparent"
        aria-hidden="true"
      />
    </>
  )}

  <h1
    class:list={[
      'max-w-4xl leading-[1.08] tracking-[-0.02em]',
      isLarge
        ? 'text-[2.05rem] sm:text-6xl lg:text-[5.25rem]'
        : 'text-4xl sm:text-5xl lg:text-6xl',
      image ? 'text-neutral-50' : 'text-neutral-800',
    ]}
  >
    <Fragment set:html={title} />
  </h1>
  <span
    class:list={[
      'order-first mb-6 block h-1 w-12 rounded-full',
      image ? 'bg-yellow-400' : 'bg-neutral-800/70',
    ]}
    aria-hidden="true"
  />
  {subTitle && (
    <p
      class:list={[
        'mt-6 max-w-xl text-base leading-relaxed sm:text-lg',
        image ? 'text-neutral-200' : 'text-neutral-800/80',
      ]}
    >
      {subTitle}
    </p>
  )}
  {Astro.slots.has('default') && (
    <div class="mt-9 flex w-full justify-start">
      <slot />
    </div>
  )}
</section>
