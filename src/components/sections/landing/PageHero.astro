---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * 內頁開頭：左邊是撕紙標題卡，右邊是一張傾斜的大拍立得（見 DESIGN.md）。
 * 首頁用的是 HomeHero（拍立得拼貼）。default slot 放在說明文字下方（按鈕、分頁按鈕等）。
 *
 * - `image`：拍立得裡的照片，放在 `src/images/heroes/`，在 view 裡 import 後傳進來。
 *   沒給照片時只顯示標題卡。
 * - `size`：保留給舊的呼叫端，`lg` 會讓標題卡稍大一點。
 */
interface Props {
  title: string;
  subTitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  size?: 'md' | 'lg';
}

const { title, subTitle, image, imageAlt = '', size = 'md' } = Astro.props;
---

<section
  class:list={[
    'mx-auto grid max-w-[85rem] items-center gap-y-2 px-2 pt-6 pb-10 sm:px-4 md:pt-10 md:pb-14 2xl:max-w-full',
    image && 'md:grid-cols-12',
  ]}
>
  <div
    class:list={[
      'torn-shadow relative z-10',
      image ? 'order-2 -mt-10 md:order-1 md:col-span-7 md:mt-0 md:-mr-16' : 'mx-auto w-full max-w-3xl',
    ]}
  >
    <div class="torn px-7 py-10 sm:px-12 sm:py-14 md:-rotate-1">
      <h1
        class:list={[
          'font-black tracking-tight text-balance text-neutral-800 dark:text-neutral-50',
          size === 'lg' ? 'text-4xl sm:text-6xl' : 'text-4xl sm:text-5xl lg:text-[3.5rem]',
        ]}
      >
        <span class="marker" set:html={title} />
      </h1>
      {subTitle && (
        <p class="mt-6 max-w-xl text-base leading-[1.85] text-neutral-700 sm:text-lg dark:text-neutral-300">
          {subTitle}
        </p>
      )}
      {Astro.slots.has('default') && (
        <div class="mt-8 flex w-full">
          <slot />
        </div>
      )}
    </div>
  </div>

  {image && (
    <figure class="polaroid order-1 mx-auto w-[88%] rotate-2 p-3 pb-10 sm:w-[70%] md:order-2 md:col-span-5 md:w-full md:rotate-3 md:p-4 md:pb-14">
      <span class="tape tape-red w-24" aria-hidden="true" />
      <Image
        src={image}
        alt={imageAlt}
        class="aspect-[4/3] w-full object-cover"
        loading="eager"
        fetchpriority="high"
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 40vw, 90vw"
      />
    </figure>
  )}
</section>
