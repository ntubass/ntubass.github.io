---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '@components/ui/icons/Icon.astro';
import { departments } from '@data/team';

/**
 * 幹部名單，每個部門一張卡片（一排一張，內容置中，照片大小一致）。`compact` 只顯示部門與成員姓名（首頁用），
 * 否則卡片內列出部門介紹與每位成員的照片、姓名、職稱（關於我們頁用）。
 * 名單在 `src/data_files/team.ts`，照片放在 `src/images/team/`。
 */
interface Props {
  compact?: boolean;
  /** Centre the text in the compact cards. */
  centered?: boolean;
}

const { compact = false, centered = false } = Astro.props;
const cardClass =
  'rounded-md bg-neutral-50/85 shadow-[0_12px_24px_-12px_rgb(60_45_30/0.45)] dark:bg-neutral-800/85';

// 讀進 src/images/team/ 裡所有照片，讓 team.ts 只要寫檔名就好
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/team/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
function photoOf(filename: string): ImageMetadata {
  const photo = photoFiles[`/src/images/team/${filename}`];
  if (!photo) {
    throw new Error(
      `找不到幹部照片 src/images/team/${filename}，請確認檔名（含副檔名、大小寫）是否正確。`
    );
  }
  return photo.default;
}
---

{
  compact ? (
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {departments.map(dept => (
        <li class:list={[cardClass, 'p-5', centered && 'text-center']}>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            {dept.name}
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            {dept.members.map(member => member.name).join('、')}
          </p>
        </li>
      ))}
    </ul>
  ) : (
    <div class="space-y-6">
      {departments.map(dept => (
        <article class:list={[cardClass, 'p-6 text-center md:p-10']}>
          <h3 class="text-2xl font-black text-neutral-800 dark:text-neutral-100">
            {dept.name}
          </h3>
          <p class="mx-auto mt-2 max-w-2xl text-pretty text-neutral-600 dark:text-neutral-400">
            {dept.description}
          </p>
          {/* 每位幹部一張拍立得：名字寫在相框下緣，職稱在下面；交錯微傾斜 */}
          <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-10 border-t border-dashed border-neutral-400 pt-10 sm:gap-x-10 dark:border-neutral-600">
            {dept.members.map((member, i) => (
              <li class="w-36 sm:w-48">
                <figure
                  class:list={[
                    'polaroid transition-transform duration-300 hover:rotate-0',
                    ['-rotate-2', 'rotate-2', '-rotate-1'][i % 3],
                  ]}
                >
                  <span
                    class:list={['tape w-16', i % 2 === 1 && 'tape-red']}
                    aria-hidden="true"
                  />
                  <div class="aspect-[4/5] overflow-hidden bg-neutral-200 dark:bg-neutral-700">
                    {member.photo ? (
                      <Image
                        src={photoOf(member.photo)}
                        alt={member.name}
                        class="h-full w-full object-cover"
                        width={400}
                        height={500}
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center text-neutral-400">
                        <Icon name="user" class="h-1/3 w-1/3" />
                      </div>
                    )}
                  </div>
                  <figcaption>
                    {member.linkedin ? (
                      <a
                        href={member.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline-offset-2 hover:text-orange-500 hover:underline"
                      >
                        {member.name}
                      </a>
                    ) : (
                      member.name
                    )}
                  </figcaption>
                </figure>
                <p class="mt-3 text-sm font-bold text-neutral-600 dark:text-neutral-400">
                  {member.title}
                </p>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  )
}
