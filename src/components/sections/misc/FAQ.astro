---
import AccordionItem from '@components/ui/blocks/AccordionItem.astro';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  subTitle?: string;
  faqs: Faq[];
  /** Anchor id, so other pages can link to `/#faq`. */
  id?: string;
}

const { title, subTitle, faqs, id } = Astro.props;
const makeId = (base: string, index: number) => `${base}${index + 1}`;
---

<section
  id={id}
  class="mx-auto max-w-[85rem] scroll-mt-28 px-4 py-12 sm:px-6 lg:px-8 lg:py-16 2xl:max-w-full"
>
  <div class="grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class="max-w-xs">
        <h2 class="text-3xl font-black tracking-tight text-neutral-800 md:text-[2.5rem] md:leading-tight dark:text-neutral-100">
          <Fragment set:html={title} />
        </h2>
        {subTitle && (
          <p class="mt-2 hidden text-neutral-600 md:block dark:text-neutral-400">
            {subTitle}
          </p>
        )}
      </div>
    </div>
    <div class="md:col-span-3">
      <div class="hs-accordion-group divide-y divide-dashed divide-neutral-400 rounded-md bg-neutral-50/80 px-6 py-2 shadow-[0_12px_24px_-12px_rgb(60_45_30/0.45)] dark:divide-neutral-600 dark:bg-neutral-800/80">
        {faqs.map((faq, i) => (
          <AccordionItem
            {...faq}
            id={makeId(`${id ?? 'faq'}-heading-`, i)}
            collapseId={makeId(`${id ?? 'faq'}-collapse-`, i)}
            first={i === 0}
          />
        ))}
      </div>
    </div>
  </div>
</section>
