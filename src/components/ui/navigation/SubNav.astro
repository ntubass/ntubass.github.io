---
/**
 * 頁面內的選單（學習資源的領域分頁、職涯發展的快速跳轉）。
 * - 白色圓角膠囊列，往上疊在橫幅下緣，和橫幅接成一體
 * - 往下捲時會停在頂部導覽列下方（sticky），隨時可以切換
 *   `sticky="desktop"`：只有電腦版會停住，手機版留在原位
 * - 手機版選項放不下時可以左右滑動
 *
 * 選項請加上 `class="subnav-item"`；目前選中的選項用 `aria-selected="true"`（分頁）
 * 或 `aria-current="true"`（跳轉連結）標示，就會變成黃色。
 */
interface Props {
  /** 什麼時候停在頂部：always（預設）或只有電腦版 desktop */
  sticky?: 'always' | 'desktop';
  /** 傳給外層容器的屬性（例如 role="tablist"、data-*） */
  [attribute: string]: unknown;
}

const { sticky = 'always', ...attrs } = Astro.props;
---

<div
  class:list={[
    'subnav-shell z-40 -mt-8 mb-6 flex justify-center px-4 sm:px-6 lg:px-8',
    sticky === 'desktop'
      ? 'relative md:sticky md:top-[5.25rem]'
      : 'sticky top-[5.25rem]',
  ]}
>
  <div
    class="subnav-track flex max-w-full gap-1 overflow-x-auto rounded-full border border-neutral-200/80 bg-neutral-50/90 p-1.5 shadow-lg shadow-neutral-900/10 backdrop-blur-md dark:border-neutral-700 dark:bg-neutral-800/90"
    {...attrs}
  >
    <slot />
  </div>
</div>

<style is:global>
  .subnav-track {
    scrollbar-width: none;
  }
  .subnav-track::-webkit-scrollbar {
    display: none;
  }
  .subnav-item {
    flex-shrink: 0;
    white-space: nowrap;
    border-radius: 9999px;
    padding: 0.55rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-neutral-600);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .subnav-item:hover {
    background-color: var(--color-yellow-100);
    color: var(--color-neutral-800);
  }
  .subnav-item:focus-visible {
    outline: 2px solid var(--color-yellow-500);
    outline-offset: 2px;
  }
  .subnav-item[aria-selected='true'],
  .subnav-item[aria-current='true'] {
    background-color: var(--color-yellow-400);
    color: var(--color-neutral-800);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .dark .subnav-item {
    color: var(--color-neutral-300);
  }
  .dark .subnav-item:hover {
    background-color: var(--color-neutral-700);
    color: var(--color-neutral-50);
  }
  .dark .subnav-item[aria-selected='true'],
  .dark .subnav-item[aria-current='true'] {
    background-color: var(--color-yellow-400);
    color: var(--color-neutral-800);
  }
</style>
