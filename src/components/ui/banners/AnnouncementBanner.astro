---
import Icon from '@components/ui/icons/Icon.astro';

const { title, btnId, btnTitle, url } = Astro.props;
const { copy: t } = Astro.locals;

interface Props {
  title?: string;
  btnId: string;
  btnTitle: string;
  url: string;
}

const storageKey = `banner-dismissed:${btnId}`;
---

<astro-banner btnId={btnId} storageKey={storageKey} class="hidden">
  <div
    class="fixed start-1/2 bottom-0 z-50 mx-auto w-full -translate-x-1/2 transform p-6 sm:max-w-4xl"
    role="region"
    aria-label={t.banner.region}
  >
    <div class="torn-shadow">
    <div class="torn bg-neutral-800! p-4 text-center dark:bg-neutral-100!">
      <div class="flex items-center justify-center">
        <div class="ml-auto">
          {title && (
            <p class="me-3 inline-block font-bold text-neutral-50 dark:text-neutral-800">
              {title}
            </p>
          )}
          <a
            class="inline-flex items-center rounded-xl border-2 border-neutral-50 bg-orange-500 px-4 py-2 text-sm font-black text-neutral-50 transition hover:bg-orange-600"
            href={url}
            target={/^https?:/.test(url) ? '_blank' : undefined}
          >
            {btnTitle}
          </a>
        </div>
        <button
          type="button"
          class="ml-auto inline-flex items-center gap-x-2 rounded-full border border-transparent bg-gray-100 p-2 text-sm font-semibold text-gray-800 hover:bg-gray-200 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-700 dark:text-neutral-50 dark:hover:bg-neutral-700/80 dark:hover:text-neutral-50 dark:focus:outline-hidden"
          id={btnId}
        >
          <span class="sr-only">{t.banner.dismiss}</span>
          <Icon name="close" class="size-5 shrink-0" />
        </button>
      </div>
    </div>
    </div>
  </div>
</astro-banner>
<script>
  class AstroBanner extends HTMLElement {
    connectedCallback() {
      const btnId = this.getAttribute('btnId');
      const storageKey = this.getAttribute('storageKey');
      if (storageKey && localStorage.getItem(storageKey) === '1') {
        this.remove();
        return;
      }
      this.classList.remove('hidden');
      const button = btnId ? this.querySelector(`#${btnId}`) : null;
      if (button != null) {
        button.addEventListener('click', () => {
          if (storageKey) localStorage.setItem(storageKey, '1');
          this.remove();
        });
      }
    }
  }

  customElements.define('astro-banner', AstroBanner);
</script>
