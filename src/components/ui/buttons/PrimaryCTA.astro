---
/**
 * 主按鈕：紅底、墨色邊框加硬陰影（像貼紙，見 DESIGN.md）。給 `url` 時是 `<a>`，
 * 否則是 `<button>`（要接 script 的話給它 `id`）。其他屬性（`data-astro-prefetch`、
 * `aria-*` 等）會原樣傳給元素。
 */
interface Props {
  title?: string;
  url?: string;
  /** 舊的呼叫端會傳這個；現在只有一種主按鈕樣式 */
  variant?: 'orange' | 'yellow';
  /** 舊的呼叫端會傳這個；主按鈕已經不加箭頭 */
  noArrow?: boolean;
  [attribute: string]: unknown;
}

const { title, url, variant: _variant, noArrow: _noArrow, ...rest } = Astro.props;

const Element = url ? 'a' : 'button';
---

<Element
  class="btn-sticker inline-flex items-center justify-center rounded-[14px] bg-orange-500 px-6 py-3.5 text-base font-black text-neutral-50 hover:bg-orange-600 disabled:pointer-events-none disabled:opacity-50"
  href={url}
  {...rest}
>
  {title}
</Element>
