---
/**
 * 次要按鈕：半透明的外框按鈕，放在主按鈕旁邊（也適合疊在 Hero 照片上）。
 */
interface Props {
  title?: string;
  url?: string;
}

const { title, url } = Astro.props;
---

<a
  class="press inline-flex items-center justify-center gap-x-2 rounded-full border border-white/40 bg-white/10 px-6 py-3.5 text-center text-[0.95rem] font-bold text-white backdrop-blur-md transition duration-200 hover:border-white/70 hover:bg-white/20"
  href={url}
>
  {title}
</a>
