---
/**
 * 次要按鈕：紙色底、墨色邊框加硬陰影，放在主按鈕旁邊。
 */
interface Props {
  title?: string;
  url?: string;
}

const { title, url } = Astro.props;
---

<a
  class="btn-sticker inline-flex items-center justify-center rounded-[14px] bg-neutral-50 px-6 py-3.5 text-center text-base font-black text-neutral-800 hover:bg-white"
  href={url}
>
  {title}
</a>
