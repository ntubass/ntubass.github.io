---
import Icon from '@components/ui/icons/Icon.astro';
import type { IconName } from '@components/ui/icons/icons';

/**
 * Grid of icon + title + text cards (核心價值, 為什麼加入我們, 課程特色).
 */
interface Item {
  icon?: IconName;
  title: string;
  description: string;
}

interface Props {
  items: Item[];
  columns?: 2 | 3 | 4;
  /** Centre the icon and text inside each card. */
  align?: 'start' | 'center';
}

const { items, columns = 3, align = 'start' } = Astro.props;
const columnClass = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];
---

<div class:list={['grid gap-x-8 gap-y-10 pt-3', columnClass]}>
  {items.map((item, i) => (
    <div
      class:list={[
        'relative rounded-md bg-neutral-50 p-7 shadow-[0_12px_24px_-12px_rgb(60_45_30/0.45)] dark:bg-neutral-800',
        i % 2 === 0 ? '-rotate-1' : 'rotate-1',
        align === 'center' && 'text-center',
      ]}
    >
      <span class:list={['tape', i % 2 === 1 && 'tape-red']} aria-hidden="true" />
      {item.icon && (
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-yellow-200 text-orange-600 dark:bg-yellow-900 dark:text-yellow-300">
          <Icon name={item.icon} class="h-6 w-6" />
        </span>
      )}
      <h3 class="mt-4 text-xl font-black text-neutral-800 dark:text-neutral-100">
        {item.title}
      </h3>
      <p class="mt-2 text-pretty text-neutral-600 dark:text-neutral-400">
        {item.description}
      </p>
    </div>
  ))}
</div>
