---
/**
 * Section title + optional subtitle. Anything passed in the default slot
 * (usually a "查看更多" link) is placed on the right on wide screens.
 */
interface Props {
  title: string;
  subTitle?: string;
  align?: 'start' | 'center';
  /** Heading level; sections use h2, the page hero uses h1. */
  as?: 'h1' | 'h2';
  id?: string;
}

const {
  title,
  subTitle,
  align = 'start',
  as: Heading = 'h2',
  id,
} = Astro.props;
const centered = align === 'center';
---

<div
  class:list={[
    'mb-8 flex flex-col gap-4 md:mb-12',
    centered
      ? 'items-center text-center'
      : 'md:flex-row md:items-end md:justify-between',
  ]}
>
  <div class:list={['max-w-3xl', centered && 'mx-auto']}>
    <Heading
      id={id}
      class:list={[
        'font-bold tracking-tight text-balance text-neutral-800 dark:text-neutral-200',
        Heading === 'h1' ? 'text-3xl md:text-4xl' : 'text-2xl md:text-3xl',
      ]}
    >
      <Fragment set:html={title} />
    </Heading>
    {subTitle && (
      <p class="mt-3 text-lg text-pretty text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    )}
  </div>
  {Astro.slots.has('default') && (
    <div class="shrink-0">
      <slot />
    </div>
  )}
</div>
