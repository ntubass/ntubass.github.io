---
/**
 * Section title + optional subtitle. Anything passed in the default slot
 * (usually a "查看更多" link) is placed on the right on wide screens.
 */
interface Props {
  title: string;
  subTitle?: string;
  align?: 'start' | 'center';
  /** Heading level; sections use h2, the page hero uses h1. */
  as?: 'h1' | 'h2';
  id?: string;
}

const {
  title,
  subTitle,
  align = 'start',
  as: Heading = 'h2',
  id,
} = Astro.props;
const centered = align === 'center';
---

<div
  class:list={[
    'mb-10 flex flex-col gap-5 md:mb-14',
    centered
      ? 'items-center text-center'
      : 'md:flex-row md:items-end md:justify-between',
  ]}
>
  <div class:list={['max-w-3xl', centered && 'mx-auto']}>
    <Heading
      id={id}
      class:list={[
        'leading-[1.15] text-neutral-900 dark:text-neutral-50',
        Heading === 'h1'
          ? 'text-4xl md:text-5xl'
          : 'text-3xl md:text-[2.75rem]',
      ]}
    >
      <Fragment set:html={title} />
    </Heading>
    {/* 標題下的黃色短線，對齊方式跟著標題 */}
    <span
      class:list={[
        'mt-5 block h-1 w-10 rounded-full bg-yellow-400',
        centered && 'mx-auto',
      ]}
      aria-hidden="true"
    />
    {subTitle && (
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    )}
  </div>
  {Astro.slots.has('default') && (
    <div class="shrink-0">
      <slot />
    </div>
  )}
</div>
