---
/**
 * Standard page section: consistent width and vertical rhythm. `tone="muted"`
 * gives the section a contrasting band so consecutive sections read apart.
 */
interface Props {
  id?: string;
  tone?: 'plain' | 'muted';
  class?: string;
}

const { id, tone = 'plain', class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-40',
    tone === 'muted' &&
      'rounded-[2rem] bg-neutral-200/70 dark:bg-neutral-900/70',
    className,
  ]}
>
  <div class="mx-auto max-w-[85rem] px-4 pt-14 pb-16 sm:px-6 lg:px-10 lg:pt-20 lg:pb-24 2xl:max-w-full">
    <slot />
  </div>
</section>
