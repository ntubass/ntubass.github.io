---
import type { CollectionEntry } from 'astro:content';
import CardRow from './CardRow.astro';
import { pathFor } from '@utils/content';
import { formatDate } from '@utils/utils';

/**
 * One interview in the 職涯訪談 list: the interviewee's photo on the right
 * (or their name as a placeholder), "date / 受訪者 · 現職" as the meta line.
 */
interface Props {
  interview: CollectionEntry<'interviews'>;
}

const { interview } = Astro.props;
const { locale } = Astro.locals;
const { title, summary, date, interviewee, photo, photoAlt } = interview.data;
const meta = [
  formatDate(date, locale),
  [interviewee.name, interviewee.position].filter(Boolean).join(' · '),
].join(' / ');
---

<CardRow
  href={pathFor(interview)}
  title={title}
  meta={meta}
  summary={summary}
  image={photo}
  imageAlt={photoAlt ?? interviewee.name}
  placeholder={interviewee.name}
  placeholderClass="bg-linear-to-br from-neutral-200 to-yellow-300"
/>
