---
import Icon from '@components/ui/icons/Icon.astro';

/** Text link with a trailing arrow, e.g. "查看更多 →". */
interface Props {
  url: string;
  title: string;
  /** Points the arrow left, for "back to …" links. */
  back?: boolean;
}

const { url, title, back = false } = Astro.props;
---

<a
  href={url}
  class="group inline-flex items-center gap-x-1.5 rounded-sm font-bold text-neutral-800 underline decoration-yellow-500 decoration-[3px] underline-offset-[6px] transition-colors hover:text-orange-500 hover:decoration-orange-500 dark:text-neutral-100"
>
  {back && (
    <Icon
      name="arrowRight"
      class="h-4 w-4 shrink-0 rotate-180 transition duration-300 group-hover:-translate-x-1"
    />
  )}
  {title}
</a>
