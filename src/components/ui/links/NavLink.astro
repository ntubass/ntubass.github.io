---
/**
 * Navigation-bar link. Highlights itself when the current page is the link's
 * page or one of its sub-pages (e.g. `/activities/2026-03-career-talk/` lights
 * up `/activities`). The home link only lights up on the home page itself.
 */
interface Props {
  url: string;
  name: string;
  /** Other path prefixes that also count as this link's section. */
  alsoActiveOn?: string[];
  /** The home link only lights up on the home page itself. */
  home?: boolean;
}

const { url, name, alsoActiveOn = [], home = false } = Astro.props;
---

<a
  href={url}
  data-nav-link={url}
  data-nav-also={alsoActiveOn.join(',')}
  data-nav-home={home ? 'true' : undefined}
  data-astro-prefetch
  class="rounded-full px-3.5 py-2 text-base font-bold text-neutral-700 transition-colors hover:bg-neutral-800/10 md:text-sm 2xl:text-base dark:text-neutral-300 dark:hover:bg-neutral-100/10"
>
  {name}
</a>

<script>
  const highlight = () => {
    const norm = (path: string) => path.replace(/\/$/, '') || '/';
    const current = norm(window.location.pathname);
    document.querySelectorAll<HTMLElement>('[data-nav-link]').forEach(link => {
      const target = norm(link.dataset.navLink ?? '');
      const under = (path: string) =>
        current === path || current.startsWith(`${path}/`);
      const also = (link.dataset.navAlso ?? '')
        .split(',')
        .filter(Boolean)
        .map(norm);
      const active =
        link.dataset.navHome === 'true'
          ? current === target
          : under(target) || also.some(under);
      if (!active) return;
      // 目前所在頁面：墨色膠囊
      link.classList.remove(
        'text-neutral-700',
        'dark:text-neutral-300',
        'hover:bg-neutral-800/10',
        'dark:hover:bg-neutral-100/10'
      );
      link.classList.add(
        'bg-neutral-800',
        'text-neutral-100',
        'dark:bg-neutral-100',
        'dark:text-neutral-900'
      );
      link.setAttribute('aria-current', 'page');
    });
  };
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', highlight);
  else highlight();
</script>
